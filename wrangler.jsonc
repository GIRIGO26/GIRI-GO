// Cloudflare Workers (static assets) – serves the prebuilt app from dist/.
// dist/ is assembled by `npm run build:cf` from the built files in the repo root
// (only what the app needs – no source, tests, supabase/ or ZIPs go public).
{
  "name": "giri-go",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none"
  }
}
